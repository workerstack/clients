{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/dist/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/_gen/**",
		"*.lock",
		".tmp/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".grok/**",
		".cursor/**",
		".repo/**",
		".vscode/**",
		"**/references/INDEX.md",
		".mcp.json",
		"**/AGENTS.md",
		".oxfmtrc.jsonc",
		"src/_tokenizer/**",
		"blueprint/**",
		"**/.cache/**"
	]
}
