{
	"name": "@workerstack/clients",
	"version": "1.0.0-rc.26",
	"description": "Generates SDKs (TypeScript, Go, Rust, Python, C#, Java), a CLI and an MCP server from any OpenAPI 3.x document.",
	"keywords": [
		"codegen",
		"mcp",
		"openapi",
		"sdk",
		"workerstack"
	],
	"homepage": "https://github.com/workerstack/clients#readme",
	"bugs": {
		"url": "https://github.com/workerstack/clients/issues"
	},
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/workerstack/clients.git"
	},
	"bin": {
		"honey-clients": "bin/honey-clients.js",
		"installgen": "bin/installgen.js"
	},
	"files": [
		"assets",
		"bin",
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"honey-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"honey-source": "./src/cli.ts",
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./installers": {
			"honey-source": "./src/installers/index.ts",
			"types": "./dist/installers/index.d.ts",
			"default": "./dist/installers/index.js"
		},
		"./release": {
			"honey-source": "./src/release/index.ts",
			"types": "./dist/release/index.d.ts",
			"default": "./dist/release/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"grunt:antigravity": "antigravity --dangerously-skip-permissions",
		"grunt:claude": "claude --dangerously-skip-permissions",
		"grunt:clean": "node ./.rulesync/scripts/clean.mjs",
		"grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"grunt:doctor": "node ./.rulesync/scripts/doctor.mjs",
		"grunt:gemini": "gemini --yolo",
		"grunt:grok": "grok --yolo",
		"grunt:hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
		"grunt:hooks:union": "node .rulesync/scripts/hooks-union.mjs",
		"grunt:purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
		"grunt:purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
		"grunt:rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
		"grunt:rulesync:doctor": "rulesync doctor",
		"grunt:rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
		"grunt:rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
		"grunt:setup": "node ./.rulesync/scripts/setup.mjs",
		"grunt:sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
		"grunt:sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
		"grunt:sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepack": "bun scripts/build.ts",
		"prepare": "lefthook install --reset-hooks-path",
		"test": "vitest run --coverage",
		"test:harness": "vitest run --mode harness",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"jiti": "2.7.0",
		"oxc-transform": "0.155.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@lovrozagar/grunt": "0.16.1",
		"@tanstack/query-core": "5.104.5",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "26.1.1",
		"@vitest/coverage-v8": "4.1.10",
		"@workerstack/backend": "1.0.0-rc.24",
		"@workerstack/system": "0.3.0",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"js-yaml": "5.3.0",
		"lefthook": "2.2.2",
		"oxc-parser": "0.152.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"rulesync": "16.17.0",
		"smol-toml": "^1.8.0",
		"standardwebhooks": "1.1.1",
		"ts-morph": "28.0.0",
		"typescript": "7.0.2",
		"vite": "8.1.4",
		"vitest": "4.1.10",
		"ws": "8.21.0"
	},
	"peerDependencies": {
		"oxfmt": ">=0.63.0",
		"ts-morph": ">=28.0.0"
	},
	"peerDependenciesMeta": {
		"oxfmt": {
			"optional": true
		},
		"ts-morph": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "bun@1.4.4",
	"standards": {
		"repo": "clients",
		"gates": [
			"test:harness"
		],
		"ci": [
			"fmt:check",
			"lint",
			"typecheck",
			"test",
			"test:harness"
		]
	}
}
